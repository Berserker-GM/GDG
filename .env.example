# --- Database -------------------------------------------------------------
# SQLite (default), Postgres or MySQL, e.g.
#   postgresql://user:pass@host:5432/leaderboard?sslmode=require   (the role must own the tables)
#   mysql+pymysql://user:pass@host:3306/leaderboard
DATABASE_URL=sqlite:///data/leaderboard.db

# --- Leaderboard ----------------------------------------------------------
# auto | team | solo
LEADERBOARD_MODE=auto
LEADERBOARD_SIZE=50
# reject a run when successful/attempted fetches is below this
MIN_SUCCESS_RATIO=0.6
# reject a run when more than this share of fetched badges is "other"
MAX_OTHER_BADGE_RATIO=0.5
SCORING_CONFIG=scoring.yaml
# a "running" run older than this is considered abandoned
RUN_LOCK_TIMEOUT_HOURS=2

# --- Fetching -------------------------------------------------------------
CONTACT_EMAIL=organizers@example.edu
# USER_AGENT defaults to "SkillLabLeaderboard/1.0 (+mailto:<CONTACT_EMAIL>)"
# USER_AGENT=
FETCH_CONCURRENCY=3
FETCH_DELAY_SECONDS=1.5
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_RETRIES=3
FETCH_BACKOFF_BASE=2.0

# --- API ------------------------------------------------------------------
# At least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-to-a-long-random-string
# Only needed when the frontend is served from another origin; leave empty when it is served at /.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Scheduler ------------------------------------------------------------
# Only ONE instance (API replica) should run the scheduler.
ENABLE_SCHEDULER=true
REFRESH_CRON=0 2 * * *
TIMEZONE=Asia/Kolkata

LOG_LEVEL=INFO
