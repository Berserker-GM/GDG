# --- Database -------------------------------------------------------------
# SQLite (default) or MySQL, e.g. mysql+pymysql://user:pass@host:3306/leaderboard
DATABASE_URL=sqlite:///data/leaderboard.db

# --- Leaderboard ----------------------------------------------------------
LEADERBOARD_MODE=auto            # auto | team | solo
LEADERBOARD_SIZE=50
MIN_SUCCESS_RATIO=0.6            # reject a run when successful/attempted fetches is below this
SCORING_CONFIG=scoring.yaml
RUN_LOCK_TIMEOUT_HOURS=2         # a "running" run older than this is considered abandoned

# --- Fetching -------------------------------------------------------------
CONTACT_EMAIL=organizers@example.edu
# USER_AGENT defaults to "SkillLabLeaderboard/1.0 (+mailto:<CONTACT_EMAIL>)"
# USER_AGENT=
FETCH_CONCURRENCY=3
FETCH_DELAY_SECONDS=1.5
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_RETRIES=3
FETCH_BACKOFF_BASE=2.0

# --- API ------------------------------------------------------------------
ADMIN_TOKEN=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Scheduler ------------------------------------------------------------
# Only ONE instance (API replica) should run the scheduler.
ENABLE_SCHEDULER=true
REFRESH_CRON=0 2 * * *
TIMEZONE=Asia/Kolkata

LOG_LEVEL=INFO
